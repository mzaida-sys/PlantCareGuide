<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F4">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layoutDirection="rtl"
            android:textDirection="rtl">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/tvWelcomeUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="أهلاً بك، مزارعنا المحترف! 👋"
                        android:textColor="#2E5A44"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تفقد حالة حديقتك اليوم"
                        android:textColor="#667C70"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMainProfile"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#3B7A57">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ملخص الحديقة الرقمية"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="right" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvTotalPlantsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@android:color/white"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="نباتات مسجلة"
                                android:textColor="#D0E1D4"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvWaterTodayCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@android:color/white"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="تحتاج سقي اليوم"
                                android:textColor="#D0E1D4"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تصفح النباتات حسب الفئة"
                android:textColor="#2E5A44"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="right"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnCatIndoor"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="🌿 نباتات داخلية (Indoor)"
                android:backgroundTint="#FFFFFF"
                android:textColor="#2E5A44"
                android:gravity="right|center_vertical"
                android:paddingRight="20dp"
                android:paddingLeft="20dp"
                android:layout_marginBottom="12dp"
                app:strokeColor="#3B7A57"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btnCatOutdoor"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="🏡 نباتات خارجية (Outdoor)"
                android:backgroundTint="#FFFFFF"
                android:textColor="#2E5A44"
                android:gravity="right|center_vertical"
                android:paddingRight="20dp"
                android:paddingLeft="20dp"
                android:layout_marginBottom="12dp"
                app:strokeColor="#3B7A57"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btnCatSucculents"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="🌵 الصباريات والعصاريات"
                android:backgroundTint="#FFFFFF"
                android:textColor="#2E5A44"
                android:gravity="right|center_vertical"
                android:paddingRight="20dp"
                android:paddingLeft="20dp"
                android:layout_marginBottom="24dp"
                app:strokeColor="#3B7A57"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>