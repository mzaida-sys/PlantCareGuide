<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F4">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل بيانات النبتة"
                android:textColor="#2E5A44"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="right"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم النبتة الحالي:"
                android:textColor="#2E5A44"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="right"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEditPlantName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:drawable/edit_text"
                android:paddingRight="12dp"
                android:paddingLeft="12dp"
                android:inputType="textPersonName"
                android:gravity="right|center_vertical"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل الفئة/التصنيف:"
                android:textColor="#2E5A44"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="right"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spEditPlantCategory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل جدول الري:"
                android:textColor="#2E5A44"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="right"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEditWaterSchedule"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:drawable/edit_text"
                android:paddingRight="12dp"
                android:paddingLeft="12dp"
                android:inputType="text"
                android:gravity="right|center_vertical"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل حاجة الإضاءة:"
                android:textColor="#2E5A44"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="right"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgEditSunlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbEditSunIndirect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ضوء غير مباشر / ظل ⛅"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginRight="4dp"
                    android:layout_gravity="right"
                    android:gravity="right|center_vertical" />

                <RadioButton
                    android:id="@+id/rbEditSunDirect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شمس مباشرة ☀️"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:layout_marginRight="4dp"
                    android:layout_gravity="right"
                    android:gravity="right|center_vertical" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل الملاحظات والإرشادات:"
                android:textColor="#2E5A44"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="right"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEditPlantNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"
                android:gravity="right|top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnEditScanOCR"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="📸 تحديث النص بالذكاء الاصطناعي (بونص)"
                android:backgroundTint="#E8F1EC"
                android:textColor="#3B7A57"
                android:textSize="12sp"
                android:layout_gravity="right"
                android:layout_marginBottom="28dp"
                style="?android:attr/borderlessButtonStyle"/>

            <Button
                android:id="@+id/btnUpdatePlant"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="🆙 حفظ وتعديل البيانات"
                android:backgroundTint="#3B7A57"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCancelEdit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="❌ إلغاء التعديل والتراجع"
                android:backgroundTint="#FFFFFF"
                android:textColor="#A32A2A"
                app:strokeColor="#A32A2A"
                app:strokeWidth="1dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>